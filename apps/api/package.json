{
  "name": "@vientos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@vientos/shared": "workspace:*",
    "ai": "7.0.107",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "inngest": "4.20.0",
    "pg": "8.23.0",
    "reductoai": "0.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.15.6",
    "@vientos/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
